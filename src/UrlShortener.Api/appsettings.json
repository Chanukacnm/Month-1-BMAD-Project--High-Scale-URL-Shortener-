{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Database=urlshortener;Username=postgres;Password=postgres",
    "Shard1": "Host=localhost;Database=urlshortener_shard1;Username=postgres;Password=postgres",
    "Shard2": "Host=localhost;Database=urlshortener_shard2;Username=postgres;Password=postgres",
    "Redis": "localhost:6379"
  },
  "GeoSharding": {
    "DefaultRegion": "us",
    "Regions": {
      "us": {
        "ShardCount": 1,
        "ConnectionStrings": [ "Host=localhost;Port=5435;Database=UrlShortenerDb;Username=postgres;Password=PostgresPassword" ]
      },
      "eu": {
        "ShardCount": 1,
        "ConnectionStrings": [ "Host=localhost;Port=5436;Database=UrlShortenerDb;Username=postgres;Password=PostgresPassword" ]
      }
    }
  },
  "RateLimiting": {
    "Policies": {
      "create": {
        "PermitLimit": 100,
        "WindowSeconds": 60
      },
      "redirect": {
        "PermitLimit": 300,
        "WindowSeconds": 60
      },
      "default": {
        "PermitLimit": 200,
        "WindowSeconds": 60
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}